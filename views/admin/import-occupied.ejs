<!--
  Import maintenance mode · page for non-initiators: same semantics as the
  ordinary maintenance home page (never leaks import progress).

  @since 1.0.0
-->
<% layout = false %><!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>维护模式 · <%= title %></title>
<style>
  * { box-sizing: border-box; }
  body { margin: 0; background: #0f0f0f; color: #eee; font-family: Arial, "PingFang SC", "Microsoft YaHei", sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }
  .card { max-width: 620px; width: 100%; }
  .eyebrow { font-size: 11px; letter-spacing: .18em; color: #888; text-transform: uppercase; }
  h1 { font: 400 clamp(28px, 6vw, 52px) Georgia, serif; margin: 18px 0 28px; line-height: 1.1; }
  .panel { border: 1px solid #333; background: #161616; padding: 24px; }
  .panel h2 { font: 400 20px Georgia, serif; margin: 0 0 14px; }
  .panel p { color: #bbb; font-size: 15px; line-height: 1.7; margin: 0; }
  .back { display: inline-block; margin-top: 20px; color: #999; font-size: 13px; text-decoration: none; }
</style>
</head>
<body>
<main class="card">
  <p class="eyebrow">MAINTENANCE MODE</p>
  <h1>站点正在维护</h1>
  <section class="panel">
    <h2>正在导入数据</h2>
    <p>本站点正在进行数据导入维护，期间前端页面暂不可用。</p>
    <p>请耐心等待几分钟，然后刷新页面。如果问题仍然存在，请联系站点管理员。</p>
  </section>
</main>
</body>
</html>